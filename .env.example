# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=          # answer layer + optional Gemini embeddings (Google AI Studio key)
# Optional extra keys (separate projects) — rotated on 429 during eval:
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
COHERE_API_KEY=          # optional reranker
# Optional overrides (defaults are in config/config.yaml)
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_GENAI_USE_VERTEXAI=1   # only if the key is bound to "Agent Platform / Vertex AI API" (aiplatform.googleapis.com)
